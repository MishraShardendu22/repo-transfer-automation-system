# GitHub OAuth Application Credentials
# Configure GitHub OAuth App at: https://github.com/settings/developers
# - Production Homepage URL: https://repo-transfer-automation-system.vercel.app
# - Production Authorization callback URL: https://repo-transfer-automation-system.vercel.app/api/auth/callback
# - Local Homepage URL: http://localhost:8080 (or http://localhost:3000)
# - Local Authorization callback URL: http://localhost:8080/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional fallback Personal Access Token (Classic with repo and admin:repo_hook permissions)
GITHUB_TOKEN_CLASSIC=

# Application & Server Configuration
# Production:
PORT=443
APP_URL=https://repo-transfer-automation-system.vercel.app
# Custom Domain (CNAME active via is-a.dev):
# APP_URL=https://repo-transfer.mishrashardendu22.is-a.dev
# Local Go server / Next.js development:
# PORT=8080
# APP_URL=http://localhost:8080

